---
import Layout from '../layouts/Layout.astro';

const features = [
  {
    title: 'Rápido',
    description: 'HTML estático por defecto y cero JavaScript en el cliente salvo que lo necesites.',
  },
  {
    title: 'Conectado',
    description: 'Integración con Daytwo para mantener tus datos sincronizados.',
  },
  {
    title: 'Escalable',
    description: 'Componentes reutilizables y una estructura lista para crecer.',
  },
];

const year = new Date().getFullYear();
---

<Layout title="Cushh Test">
  <header class="nav container">
    <a href="/" class="brand">Cushh</a>
    <nav>
      <a href="#features">Características</a>
      <a href="#contacto">Contacto</a>
    </nav>
  </header>

  <main>
    <section class="hero container">
      <span class="badge">Conectado con Daytwo</span>
      <h1>Bienvenido a <span class="highlight">Cushh Test</span></h1>
      <p class="lead">
        Una página de inicio construida con Astro: ligera, rápida y lista para personalizar.
      </p>
      <div class="actions">
        <a href="#features" class="btn btn-primary">Empezar</a>
        <a href="https://docs.astro.build" class="btn btn-secondary" target="_blank" rel="noopener">
          Documentación
        </a>
      </div>
    </section>

    <section id="features" class="container">
      <h2>Características</h2>
      <div class="grid">
        {
          features.map((feature) => (
            <article class="card">
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="contacto" class="cta container">
      <h2>¿Listo para empezar?</h2>
      <p>Escríbenos y te ayudamos a poner en marcha tu proyecto.</p>
      <a href="mailto:hola@example.com" class="btn btn-primary">Contactar</a>
    </section>
  </main>

  <footer class="container">
    <p>© {year} Cushh. Todos los derechos reservados.</p>
  </footer>
</Layout>

<style>
  .container {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .brand {
    font-weight: 800;
    font-size: 1.25rem;
    text-decoration: none;
  }

  .nav nav {
    display: flex;
    gap: 20px;
  }

  .nav nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .nav nav a:hover {
    color: var(--text);
  }

  .hero {
    text-align: center;
    padding-top: 96px;
    padding-bottom: 96px;
  }

  .badge {
    display: inline-block;
    padding: 4px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--muted);
    background: var(--surface);
  }

  h1 {
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    line-height: 1.1;
    margin: 24px 0 16px;
  }

  .highlight {
    color: var(--accent);
  }

  .lead {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 560px;
    margin: 0 auto;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  .btn {
    display: inline-block;
    padding: 12px 22px;
    border-radius: 10px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
    opacity: 0.92;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-contrast);
  }

  .btn-secondary {
    border: 1px solid var(--border);
    background: var(--surface);
  }

  h2 {
    font-size: 1.75rem;
    text-align: center;
    margin-bottom: 32px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }

  .card {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
  }

  .card h3 {
    margin: 0 0 8px;
  }

  .card p {
    margin: 0;
    color: var(--muted);
  }

  .cta {
    text-align: center;
    padding-top: 96px;
    padding-bottom: 96px;
  }

  .cta h2 {
    margin-bottom: 8px;
  }

  .cta p {
    color: var(--muted);
    margin-bottom: 24px;
  }

  footer {
    border-top: 1px solid var(--border);
    padding-top: 24px;
    padding-bottom: 24px;
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
